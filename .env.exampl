# ------------------------------------------------------------------                                                                                                   
  # Copia este archivo como  .env  en la misma carpeta que buscar_empleo_V9.py                                                                                           
  # y completa tus valores. NUNCA subas el .env al repositorio.                                                                                                          
  # ------------------------------------------------------------------                                                                                                   
                                                                                                                                                                         
  # Cuenta de Gmail que recibe las alertas de empleo y a la que se envía el resumen diario.                                                                              
  EMAIL_USUARIO=tu.correo@gmail.com                                                                                                                                      
  # Contraseña de aplicación de Gmail (16 caracteres, NO la contraseña normal).                                                                                          
  # Se crea en https://myaccount.google.com/apppasswords con la verificación en dos pasos activa.                                                                        
  EMAIL_PASSWORD=xxxx xxxx xxxx xxxx  

# Cabecera de cada CV en PDF: nombre y línea de contacto tal como deben imprimirse.                                                                                    
  NOMBRE_CANDIDATA=NOMBRE APELLIDO                                                                                                                                       
  CONTACTO_CANDIDATA=Ciudad, País (Remoto) · correo@ejemplo.com · linkedin.com/in/usuario                                                                                
                                                                                                                                                                         
  # Proveedor del modelo (DeepInfra, API compatible con OpenAI): https://deepinfra.com/dash/api_keys                                                                     
  DEEPINFRA_API_KEY=tu_clave_de_deepinfra                                                                                                                                
  MODELO_LLM=deepseek-ai/DeepSeek-V4.1-Flash                                                                                                                             
  # Opcional: modelo distinto para los dos últimos reintentos si el principal está saturado.                                                                             
  # MODELO_RESPALDO=deepseek-ai/DeepSeek-V4.1-Flash                                                                                                                      
                                                                                                                                                                         
  # Airtable: token personal (https://airtable.com/create/tokens) con permisos                                                                                           
  # data.records:read, data.records:write y schema.bases:read sobre la base del tracker.                                                                                 
  AIRTABLE_TOKEN=pat_tu_token                                                                                                                                            
  AIRTABLE_BASE=appXXXXXXXXXXXXXX                                                                                                                                        
  AIRTABLE_TABLA=tblXXXXXXXXXXXXXX 

# Opcional: webhook (Make o n8n) del botón "Ya apliqué" y un secreto que el escenario valida.                                                                          
  WEBHOOK_URL=https://hook.example.com/tu-webhook                                                                                                                        
  WEBHOOK_TOKEN=un_secreto_largo                                                                                                                                         
                                                                                                                                                                         
  # Opcionales de lectura de correo.                                                                                                                                     
  # DIAS_ATRAS=3                    # días hacia atrás para buscar alertas de empleo                                                                                     
  # DIAS_ATRAS_SEGUIMIENTO=4        # días hacia atrás para buscar respuestas de empresas
  # CARPETA_IMAP_SEGUIMIENTO=inbox  # "todos" para incluir correos archivados
